android_app {
    name: "uwuComponentGallery",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "26",
    static_libs: [
        "uwuComposeSettingsLib",
        "androidx.activity_activity-compose",
    ],
    kotlincflags: ["-Xjvm-default=all"],
}
